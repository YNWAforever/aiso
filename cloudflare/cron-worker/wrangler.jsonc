{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fimmick-aeo-cron-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Matches lib/app-origin.ts's own DEFAULT_APP_ORIGIN fallback, so a fresh
  // deploy works without any extra setup step. Override here (or with
  // `wrangler deploy --var APP_BASE_URL:...`) only when targeting a
  // non-production environment.
  "vars": {
    "APP_BASE_URL": "https://aiso-kappa.vercel.app"
  },
  // Proposed source only. Parity with the dedicated config: the verified live
  // Pulse and alerts ticks, plus `17 16 * * *` (00:17 UTC+8, brand-months only).
  // `0 9 * * *` stays unscheduled. Deploying this file is not authorized.
  "triggers": {
    "crons": [
      "17 4 * * *",
      "47 7 * * 1",
      "17 16 * * *"
    ]
  }
}
