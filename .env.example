# Names and comments only — never real values. See CLAUDE.md for the full
# architecture notes; this file just says what each variable gates and
# whether it is required at build time or only at runtime.

# --- Database -----------------------------------------------------------
# Neon Postgres connection string. Read lazily by db() (lib/db.ts), so
# `next build` succeeds with this unset — only runtime queries need it.
DATABASE_URL=

# --- Neon Auth ------------------------------------------------------------
# Neon Auth issuer base URL. Runtime-only.
NEON_AUTH_BASE_URL=
# Cookie signing secret, >=32 chars. REQUIRED AT BUILD TIME — app/api/auth/[...path]/route.ts
# calls auth().handler() at module scope, so `next build` fails without this set
# (see "Build-time env requirement" in CLAUDE.md).
NEON_AUTH_COOKIE_SECRET=
# Comma-separated, verified-email admin bootstrap allowlist (lib/auth.ts getProfile()).
# Server-only — never prefix with NEXT_PUBLIC_. Runtime-only. Set in Production only;
# Preview currently shares Production's DATABASE_URL, so a Preview-scoped value is not isolated.
ADMIN_EMAILS=

# --- Stripe -----------------------------------------------------------
# Stripe API secret key. Read lazily by the lib/stripe.ts Proxy — runtime-only,
# does not block `next build`.
STRIPE_SECRET_KEY=
# Signing secret for POST /api/stripe/webhook signature verification. Runtime-only.
STRIPE_WEBHOOK_SECRET=
# Checkout price ids for the three self-serve plans. Runtime-only (build succeeds
# without them), but each plan whose price id is unset is unpurchasable: the
# pricing page renders it as unavailable and POST /api/stripe/checkout returns
# 503 PLAN_UNAVAILABLE for it. Required in Production + Preview to sell that plan.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Report sharing -------------------------------------------------------
# HMAC signing secret for public client-report share links (lib/reports/share.ts),
# >=32 random characters. Runtime-only. Required in Production + Preview.
REPORT_SHARE_SECRET=

# --- Public scan abuse protection -----------------------------------------
# HMAC key for the anonymous public-scan rate limiter, >=32 random characters.
# Runtime-only. The public scan endpoint fails closed without it. Required in
# Production + Preview before releasing public scans.
PUBLIC_SCAN_RATE_LIMIT_SECRET=

# --- Email ------------------------------------------------------------
# Resend API key for transactional email. Runtime-only.
RESEND_API_KEY=
# Optional — has a code fallback if unset. Runtime-only.
RESEND_FROM_EMAIL=

# --- LLM ------------------------------------------------------------
# OpenRouter API key, used by lib/openrouter.ts for all LLM calls
# (fix packs, agent recommendations, pulse, authority scoring). Runtime-only.
OPENROUTER_API_KEY=

# --- App URLs / automation -------------------------------------------------
# Absolute base URL used in email links, OG images, and Stripe checkout
# success/cancel redirects. Client-exposed (NEXT_PUBLIC_ prefix). Runtime-only;
# falls back to the Vercel preview URL if unset.
NEXT_PUBLIC_APP_URL=
# n8n scan-automation webhook URL. Runtime-only.
N8N_SCAN_WEBHOOK_URL=
# Guards /api/cron/*. Runtime-only. Prefer the `x-cron-secret` header convention
# for new cron routes (see CLAUDE.md — the two existing cron routes disagree).
CRON_SECRET=

# --- Optional, with code fallbacks -----------------------------------------
WIKIPEDIA_USER_AGENT=

# --- E2E (Playwright) only, not needed for `npm run dev` / `npm run build` ---
BASE_URL=
START_DEV_SERVER=
CI=
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
