# Fimmick AEO — environment variables
#
# Copy to .env.local and fill in. Every entry below says what BREAKS when it is
# missing, not just what it is — several failures are silent, or look like an
# unrelated outage. There is no startup validation: db() and auth() are lazy
# singletons specifically so the build survives missing config, so a missing
# variable surfaces at first use rather than at boot.

# ─── Required in production ──────────────────────────────────────────────────

# Neon connection string. Without it every DB path 500s; /api/scan returns an
# explicit "missing DATABASE_URL" 500.
# Careful: the Neon driver echoes the full URL, password included, in its error
# messages. Never paste it into a shell command — pipe through
# `2>&1 | grep -v "postgresql://"` when scripting against it.
DATABASE_URL=

# Neon Auth. BASE_URL is runtime-only; COOKIE_SECRET is required at BUILD time
# and must be >= 32 chars — `next build` fails collecting page data for
# /api/auth/[...path] without it, because that route calls auth().handler() at
# module scope. Vercel deploys fail, not just requests.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# HMAC key for the durable public-scan and funnel-event rate limiters. >= 32
# chars. The local-development fallback is deliberately withheld in production,
# so if this is unset there, EVERY anonymous scan and every scan-claim-intent
# returns 503 — the whole public funnel goes dark while authenticated smoke
# tests stay green. The most dangerous omission in this file.
PUBLIC_SCAN_RATE_LIMIT_SECRET=

# Signs public report share links AND the scan-claim intent cookie — two
# consumers, not one. >= 32 chars. Unset: share links 404, publish/rotate 503,
# and the scan-to-signup claim funnel degrades to a fixed 403.
REPORT_SHARE_SECRET=

# Stripe. Without the webhook secret, constructEvent throws and EVERY webhook
# returns 400 "Invalid signature" — subscriptions silently never provision.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform-provided on Vercel, but a hard dependency: production rate limiting
# throws unless VERCEL=1, so a self-hosted production deploy cannot serve
# anonymous scans at all.
# VERCEL=1

# ─── Required if the feature is enabled ──────────────────────────────────────

# Stripe price ids. Checkout guards these and returns a clean 500 per plan; the
# webhook does NOT — with them unset no price matches and tier resolution falls
# through, so a paid upgrade can resolve to the wrong plan.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# OpenRouter. Fix packs and AI report summaries throw without it. GEO checks
# c18/c19 degrade quietly to check_error instead, costing the caller points
# with no error surfaced anywhere.
OPENROUTER_API_KEY=

# Bearer token for the n8n MCP server in .mcp.json. Tooling only, not the app.
N8N_MCP_TOKEN=

# ─── Optional — fallbacks shown ──────────────────────────────────────────────

# Public origin for SEO canonicals, Stripe redirects and report share links.
# Falls back to https://aeo.fimmick.com (lib/app-origin.ts).
NEXT_PUBLIC_APP_URL=

# Fire-and-forget scan webhook. Unset = feature simply off, no user impact.
N8N_SCAN_WEBHOOK_URL=

# Falls back to alerts@fimmick-aeo.com.
RESEND_FROM_EMAIL=

# Falls back to "FimmickAISO/1.0 (https://fimmick.com)".
WIKIPEDIA_USER_AGENT=

# ─── Currently dead — listed so nobody re-adds them expecting an effect ──────

# RESEND_API_KEY — sendAlertEmail() has zero callers; alerting is fenced.
# CRON_SECRET    — zero readers. Both /api/cron routes are 503 stubs with no
#                  secret check. (n8n has its own $env.CRON_SECRET; unrelated.)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — read by no source file; checkout is
#                  server-side only.
# NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY / SUPABASE_SERVICE_ROLE_KEY — the Neon
#                  migration is complete; no application code reads these.

# ─── Tests and E2E only ──────────────────────────────────────────────────────

# TEST_DATABASE_URL is set by the integration harness per run; do not set it by
# hand. NEON_API_KEY authenticates neonctl in CI instead of `neonctl auth`.
#
# REQUIRE_INTEGRATION_TESTS=1 makes `npm test` FAIL rather than skip when
# neonctl is unavailable — the command that proves the full suite ran.
# SKIP_INTEGRATION_TESTS=1 forces the skip deliberately.
#
# Playwright: BASE_URL, START_DEV_SERVER=1, CI, PLAYWRIGHT_TEST_EMAIL,
# PLAYWRIGHT_TEST_PASSWORD, PLAYWRIGHT_AUTH_STORAGE_STATE,
# PLAYWRIGHT_CLIENT_REPORT_FIXTURE, LIVE_SCAN_TARGET, SKIP_E2E_SEED.
