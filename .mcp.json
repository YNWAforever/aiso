{
  "mcpServers": {
    "neon": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres@0.6.2",
        "${DATABASE_URL}"
      ]
    },
    "n8n-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "supergateway",
        "--streamableHttp",
        "https://anfield-n8n.zeabur.app/mcp-server/http",
        "--header",
        "authorization:Bearer ${N8N_MCP_TOKEN}"
      ]
    }
  }
}
